#!/bin/sh /etc/rc.common
# Thundergeddon game server. Installed to /etc/init.d/thundergeddon by
# Server/deploy.ps1. procd starts it at boot and restarts it if it crashes.
# Its log goes to the system log:  logread -f -e thundergeddon

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /opt/thundergeddon/thundergeddon -addr :8088 -token-file /etc/thundergeddon/ws_token.txt
	# Restart 5 s after a crash, forever.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
